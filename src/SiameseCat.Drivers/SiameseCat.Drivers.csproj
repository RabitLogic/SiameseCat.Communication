<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SiameseCat.Drivers</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>SiameseCat.Drivers</PackageId>
    <Version>1.0.0</Version>
    <Authors>RabitLogic</Authors>
    <Description>Brand driver layer for SiameseCat: Siemens and Inovance PLC drivers with native address mapping.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RabitLogic/SiameseCat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>plc;siemens;inovance;driver</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiameseCat.Core\SiameseCat.Core.csproj" />
    <ProjectReference Include="..\SiameseCat.Protocols\SiameseCat.Protocols.csproj" />
  </ItemGroup>

</Project>
