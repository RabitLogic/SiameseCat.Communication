<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SiameseCat.Communication.Hosting</PackageId>
    <Description>Dependency injection, health checks, slave hosting and logging integration for SiameseCat.</Description>
    <PackageTags>hosting;dependency-injection;health-checks;industrial;automation</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiameseCat.Communication.Core\SiameseCat.Communication.Core.csproj" />
    <ProjectReference Include="..\SiameseCat.Communication.Modbus\SiameseCat.Communication.Modbus.csproj" />
    <ProjectReference Include="..\SiameseCat.Communication.S7\SiameseCat.Communication.S7.csproj" />
    <ProjectReference Include="..\SiameseCat.Communication.Simulation.Modbus\SiameseCat.Communication.Simulation.Modbus.csproj" />
    <ProjectReference Include="..\SiameseCat.Communication.Simulation.S7\SiameseCat.Communication.Simulation.S7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

</Project>
