<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <!--
      Assets are built for the LTS generations plus netstandard2.0. The lowest modern TFM is a floor,
      not a ceiling: net9.0 (STS), net11.0 and later resolve the nearest lower asset automatically.
    -->
    <SiameseCatTargetFrameworks Condition="'$(SiameseCatTargetFrameworks)' == ''">net8.0;net10.0;netstandard2.0</SiameseCatTargetFrameworks>
    <TargetFrameworks>$(SiameseCatTargetFrameworks)</TargetFrameworks>
    <Version>0.10.0</Version>
    <Authors>RabitLogic</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RabitLogic/SiameseCat.Communication</RepositoryUrl>
    <RepositoryType>Git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <Description>SiameseCat industrial communication library.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Shared/*.cs" LinkBase="Shared" />
    <InternalsVisibleTo Include="SiameseCat.Tests" />
  </ItemGroup>

</Project>
