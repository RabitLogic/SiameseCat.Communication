<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>SiameseCat.Communication.Simulation.S7</PackageId>
    <Description>In-process S7 (ISO-on-TCP) slave for SiameseCat.</Description>
    <PackageTags>s7;siemens;slave;simulator</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\SimulatorShared\SimulatorLimits.cs" LinkBase="SimulatorShared" />
    <ProjectReference Include="..\SiameseCat.Communication.Core\SiameseCat.Communication.Core.csproj" />
    <ProjectReference Include="..\SiameseCat.Communication.S7\SiameseCat.Communication.S7.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

</Project>
