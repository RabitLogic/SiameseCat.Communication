<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Assets are built for the LTS generations plus netstandard2.0. The lowest modern TFM is a floor,
      not a ceiling: net9.0 (STS), net11.0 and later resolve the nearest lower asset automatically.
      To build an asset for a newer framework, pass -p:SiameseCatTargetFrameworks=net11.0 (or a list).
    -->
    <SiameseCatTargetFrameworks Condition="'$(SiameseCatTargetFrameworks)' == ''">net8.0;net10.0;netstandard2.0</SiameseCatTargetFrameworks>
    <TargetFrameworks>$(SiameseCatTargetFrameworks)</TargetFrameworks>
    <RootNamespace>SiameseCat.Communication</RootNamespace>
    <AssemblyName>SiameseCat.Communication</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <PackageId>SiameseCat.Communication</PackageId>
    <Version>0.9.1</Version>
    <Authors>RabitLogic</Authors>
    <Description>Industrial communication library for .NET: Modbus RTU/TCP, S7, pluggable PLC drivers, TCP/UDP/serial transports, Modbus and S7 slaves, dependency injection, health checks and metrics.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RabitLogic/SiameseCat.Communication</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>plc;modbus;modbus-tcp;modbus-rtu;s7;industrial;automation;serialport;scada</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SiameseCat.Tests" />
  </ItemGroup>

</Project>
