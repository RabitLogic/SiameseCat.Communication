<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.0</TargetFrameworks>
    <RootNamespace>SiameseCat.Transport</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.0'">true</IsAotCompatible>
    <PackageId>SiameseCat.Transport</PackageId>
    <Version>1.0.0</Version>
    <Authors>RabitLogic</Authors>
    <Description>Transport layer for SiameseCat: raw TCP and serial port ITransport implementations.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/RabitLogic/SiameseCat</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>plc;communication;transport;tcp;serialport</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SiameseCat.Core\SiameseCat.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Ports" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" PrivateAssets="all" />
    <PackageReference Include="System.Memory" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
  </ItemGroup>

</Project>
