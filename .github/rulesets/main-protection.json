      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {
            "context": "build"
          },
          {
            "context": "Framework matrix"
          },
          {
            "context": "dotnet-framework"
          },
          {
            "context": "Soak (fault injection)"
          }
        ]
      }
    }
  ]
}
