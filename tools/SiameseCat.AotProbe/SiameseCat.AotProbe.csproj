<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SiameseCat.AotProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyName>SiameseCat.AotProbe</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- PublishAotCross.Tools enables cross-OS AOT publishing (Zig for Linux/macOS, xwin for Windows). -->
    <StripSymbols Condition="!$(RuntimeIdentifier.StartsWith('osx'))">true</StripSymbols>
    <UseLdClassicXCodeLinker Condition="$(RuntimeIdentifier.StartsWith('osx'))">false</UseLdClassicXCodeLinker>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PublishAotCross.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiameseCat.Core\SiameseCat.Core.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Transport\SiameseCat.Transport.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Protocols\SiameseCat.Protocols.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Drivers\SiameseCat.Drivers.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Hosting\SiameseCat.Hosting.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Server\SiameseCat.Server.csproj" />
  </ItemGroup>

  <!--
    Optional GC provider hook. The garbage collector is chosen by the host runtime, not by the
    libraries, so a provider such as SatoriGC only applies to this publishable project. Point
    SatoriGCTargetsPath at the provider's .props/.targets file, or drop it at eng/SatoriGC.targets;
    nothing is imported when the file is absent.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\SatoriGC.targets"
          Condition="'$(SatoriGCTargetsPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\eng\SatoriGC.targets')" />
  <Import Project="$(SatoriGCTargetsPath)"
          Condition="'$(SatoriGCTargetsPath)' != '' and Exists('$(SatoriGCTargetsPath)')" />

</Project>