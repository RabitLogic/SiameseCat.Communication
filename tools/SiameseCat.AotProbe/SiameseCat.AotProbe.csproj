<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SiameseCat.AotProbe</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyName>SiameseCat.AotProbe</AssemblyName>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <DebuggerSupport>false</DebuggerSupport>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>

    <!-- PublishAotCross.Tools enables cross-OS AOT publishing (Zig for Linux/macOS, xwin for Windows). -->
    <StripSymbols Condition="!$(RuntimeIdentifier.StartsWith('osx'))">true</StripSymbols>
    <UseLdClassicXCodeLinker Condition="$(RuntimeIdentifier.StartsWith('osx'))">false</UseLdClassicXCodeLinker>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PublishAotCross.Tools" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiameseCat.Core\SiameseCat.Core.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Transport\SiameseCat.Transport.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Protocols\SiameseCat.Protocols.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Drivers\SiameseCat.Drivers.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Hosting\SiameseCat.Hosting.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Server\SiameseCat.Server.csproj" />
  </ItemGroup>

</Project>