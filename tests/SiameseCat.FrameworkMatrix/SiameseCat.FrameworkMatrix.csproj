<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- net11.0 is added automatically when the installed SDK can build it. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <TargetFrameworks Condition="$([System.String]::Copy('$(NETCoreSdkVersion)').StartsWith('11.'))">net8.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>SiameseCat.FrameworkMatrix</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiameseCat.Communication.All\SiameseCat.Communication.All.csproj" />
  </ItemGroup>

</Project>
