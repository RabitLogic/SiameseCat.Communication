<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SiameseCat.Demo</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiameseCat.Core\SiameseCat.Core.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Transport\SiameseCat.Transport.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Protocols\SiameseCat.Protocols.csproj" />
    <ProjectReference Include="..\..\src\SiameseCat.Drivers\SiameseCat.Drivers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiameseCat.Server\SiameseCat.Server.csproj" />
  </ItemGroup>

  <!--
    Optional GC provider hook (see tools/SiameseCat.AotProbe/SiameseCat.AotProbe.csproj).
    Point SatoriGCTargetsPath at the provider file, or drop it at eng/SatoriGC.targets.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\..\eng\SatoriGC.targets"
          Condition="'$(SatoriGCTargetsPath)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\eng\SatoriGC.targets')" />
  <Import Project="$(SatoriGCTargetsPath)"
          Condition="'$(SatoriGCTargetsPath)' != '' and Exists('$(SatoriGCTargetsPath)')" />

</Project>