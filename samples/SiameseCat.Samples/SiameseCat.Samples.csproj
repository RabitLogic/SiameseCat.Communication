<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SiameseCat.Samples</RootNamespace>
    <IsPackable>false</IsPackable>
    <AssemblyName>SiameseCat.Samples</AssemblyName>
    <!-- Console output is meant to be read by a human: keep the current culture and inline demo arrays. -->
    <NoWarn>$(NoWarn);CA1305;CA1861</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SiameseCat.Communication\SiameseCat.Communication.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

</Project>
